# T002 — environment variables
# Copy to .env and fill in real values.
# With JALSETU_MOCK_LLM=1 the demo runs fully offline — no API keys needed.

JALSETU_MOCK_LLM=1

# Watsonx.ai (only needed when JALSETU_MOCK_LLM=0)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Road routing (only needed when JALSETU_MOCK_LLM=0, uses haversine fallback otherwise)
ROAD_ROUTING_API_KEY=
