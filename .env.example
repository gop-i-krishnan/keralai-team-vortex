# JalSetu environment template (dummy values only; never commit real keys).
# Default: fully offline. The demo needs no API keys.
JALSETU_MOCK_LLM=1

# Optional IBM watsonx.ai Granite parsing. Used ONLY if JALSETU_MOCK_LLM=0 and
# `pip install ibm-watsonx-ai` has been run. Parsing text only; never pricing/ranking.
WATSONX_API_KEY=insert_key_here
WATSONX_PROJECT_ID=insert_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Frontend (frontend/.env): backend URL, default shown
VITE_API_URL=http://localhost:8000/api
